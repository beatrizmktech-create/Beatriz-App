DTSTAMP:20261014T120000Z
DTSTART:20261019T121500
DTEND:20261019T123500
RRULE:FREQ=DAILY;UNTIL=20270111T235900
SUMMARY:Almoço pequeno
DESCRIPTION:Prato de sobremesa\, não prato raso\n2 colheres (sopa) de le
 gume cozido macio (cenoura\, abobrinha\, abóbora) + fio de azeite\nProt
 eína macia: 2 colheres (sopa) de frango desfiado no molho\, ou 1 ovo\, 
 ou omelete\n1 concha de feijão (pode ser só o caldo grosso ou batido)\
 n3 colheres (sopa) de arroz ou purê\n\nDia difícil: Sopa creme ou 1 co
 po de leite + 1 ovo. Se não descer nada\, faça o shake.
BEGIN:VALARM
ACTION:DISPLAY
DESCRIPTION:Almoço pequeno
TRIGGER:PT0M
END:VALARM
END:VEVENT
